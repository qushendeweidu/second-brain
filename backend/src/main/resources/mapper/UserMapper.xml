<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.laodeng.backend.mapper.UserMapper">

    <resultMap id="UserVOMap" type="com.laodeng.backend.domain.vo.UserVO">
        <result column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="nickname" property="nickName"/>
        <result column="email" property="email"/>
        <result column="phone" property="phone"/>
        <result column="status" property="status"/>
        <result column="avatar" property="avatar"/>
        <result column="roles" property="roles"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="permissions" property="permissions"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="user_create_time" property="userCreateTime"/>
        <result column="user_update_time" property="userUpdateTime"/>
        <result column="role_create_time" property="roleCreateTime"/>
        <result column="role_update_time" property="roleUpdateTime"/>
    </resultMap>

    <select id="getUserVOByUserDTO"
            parameterType="com.laodeng.backend.domain.dto.UserDTO"
            resultMap="UserVOMap">

        SELECT
        u.id,
        u.username,
        u.nickname,
        u.email,
        u.phone,
        u.status,
        up.avatar,
        ur.roles,
        ur.permissions,

        u.create_time AS user_create_time,
        u.update_time AS user_update_time,
        ur.create_time AS role_create_time,
        ur.update_time AS role_update_time

        FROM user u

        LEFT JOIN user_role ur
        ON u.id = ur.user_id

        LEFT JOIN user_profile up
        ON u.id = up.user_id


        <where>

            <!-- 用户基础信息 -->
            <if test="userDTO.username != null and userDTO.username != ''">
                AND u.username = #{userDTO.username}
            </if>

            <if test="userDTO.nickName != null and userDTO.nickName != ''">
                AND u.nickname = #{userDTO.nickName}
            </if>

            <if test="userDTO.email != null and userDTO.email != ''">
                AND u.email = #{userDTO.email}
            </if>

            <if test="userDTO.phone != null and userDTO.phone != ''">
                AND u.phone = #{userDTO.phone}
            </if>

            <if test="userDTO.status != null">
                AND u.status = #{userDTO.status}
            </if>


            <!-- 角色筛选 -->
            <if test="userDTO.roles != null and userDTO.roles.size() > 0">
                AND
                <foreach item="role"
                         collection="userDTO.roles"
                         open="("
                         close=")"
                         separator=" OR ">
                    JSON_CONTAINS(
                    ur.roles,
                    JSON_QUOTE(#{role})
                    )
                </foreach>
            </if>


            <!-- 权限筛选 -->
            <if test="userDTO.permissions != null and userDTO.permissions.size() > 0">
                AND
                <foreach item="permission"
                         collection="userDTO.permissions"
                         open="("
                         close=")"
                         separator=" OR ">
                    JSON_CONTAINS(
                    ur.permissions,
                    JSON_QUOTE(#{permission})
                    )
                </foreach>

            </if>


            <!-- 用户创建时间范围 -->
            <if test="userDTO.userCreateStartTime != null">
                AND u.create_time &gt;= #{userDTO.userCreateStartTime}
            </if>

            <if test="userDTO.userCreateEndTime != null">
                AND u.create_time &lt;= #{userDTO.userCreateEndTime}
            </if>


            <!-- 用户更新时间范围 -->
            <if test="userDTO.userUpdateStartTime != null">
                AND u.update_time &gt;= #{userDTO.userUpdateStartTime}
            </if>

            <if test="userDTO.userUpdateEndTime != null">
                AND u.update_time &lt;= #{userDTO.userUpdateEndTime}
            </if>


            <!-- 角色创建时间范围 -->
            <if test="userDTO.roleCreateStartTime != null">
                AND ur.create_time &gt;= #{userDTO.roleCreateStartTime}
            </if>

            <if test="userDTO.roleCreateEndTime != null">
                AND ur.create_time &lt;= #{userDTO.roleCreateEndTime}
            </if>


            <!-- 角色更新时间范围 -->
            <if test="userDTO.roleUpdateStartTime != null">
                AND ur.update_time &gt;= #{userDTO.roleUpdateStartTime}
            </if>

            <if test="userDTO.roleUpdateEndTime != null">
                AND ur.update_time &lt;= #{userDTO.roleUpdateEndTime}
            </if>

        </where>

    </select>

</mapper>
